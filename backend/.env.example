# Variáveis de ambiente do back-end. No Render, cadastre em Environment > Environment Variables.
# Localmente, exporte no terminal antes de rodar (veja o README).

# Chave da API do Resend (obrigatória para enviar e-mail). Crie em https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave_aqui

# E-mail que recebe as mensagens do formulário
CONTACT_RECEIVER=jpaulo.rodrigues04@gmail.com

# Remetente. Sem domínio verificado no Resend, use onboarding@resend.dev
CONTACT_FROM=Portfolio jprodrigues.me <onboarding@resend.dev>

# true = manda confirmação para quem escreveu (só funciona com domínio verificado no Resend)
CONTACT_SEND_CONFIRMATION=false

# Sites autorizados a chamar a API, separados por vírgula
ALLOWED_ORIGINS=http://localhost:5173,https://jprodrigues.me,https://www.jprodrigues.me
