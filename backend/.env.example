# Copie este arquivo para backend/.env e preencha. O Spring Boot lê o .env sozinho
# quando você roda "mvn spring-boot:run" dentro da pasta backend.
# O .env está no .gitignore: as chaves NUNCA vão para o GitHub.
# No Render, cadastre as mesmas variáveis em Environment > Environment Variables.

# ---------------------------------------------------------------------------
# Opção 1: Gmail por SMTP (para testar no seu computador)
# Mesmo esquema do projeto SendEmail da disciplina.
# A senha é uma "Senha de app" (16 letras): https://myaccount.google.com/apppasswords
# (exige a verificação em duas etapas ativada na conta Google)
# ---------------------------------------------------------------------------
GMAIL_USERNAME=jpaulo.rodrigues04@gmail.com
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Opção 2: Resend (para o Render, que bloqueia SMTP no plano gratuito)
# Crie a chave em https://resend.com/api-keys. Se preenchida, tem prioridade sobre o Gmail.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Sem domínio verificado no Resend, o remetente tem que ser onboarding@resend.dev
CONTACT_FROM=Portfolio jprodrigues.me <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Geral
# ---------------------------------------------------------------------------
# E-mail que recebe as mensagens do formulário
CONTACT_RECEIVER=jpaulo.rodrigues04@gmail.com
# Envia uma confirmação para quem escreveu (com Gmail funciona direto;
# com Resend, só depois de verificar o domínio jprodrigues.me)
CONTACT_SEND_CONFIRMATION=true
# Sites autorizados a chamar a API, separados por vírgula
ALLOWED_ORIGINS=http://localhost:5173,https://jprodrigues.me,https://www.jprodrigues.me
