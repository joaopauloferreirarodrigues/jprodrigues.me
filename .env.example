# Copie este arquivo para .env.local e preencha com os dados do painel do EmailJS.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
VITE_EMAILJS_SERVICE_ID=seu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID_FOR_ME=seu_template_id_for_me_aqui
VITE_EMAILJS_TEMPLATE_ID_FOR_SENDER=seu_template_id_for_sender_aqui
VITE_EMAILJS_PUBLIC_KEY=sua_public_key_aqui
