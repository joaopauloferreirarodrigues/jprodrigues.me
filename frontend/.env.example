# Copie este arquivo para .env.local e ajuste.
# Na Vercel, cadastre a mesma variável em Settings > Environment Variables.

# URL do back-end Spring Boot (sem barra no final)
# Local:  http://localhost:8080
# Render: https://jprodrigues-api.onrender.com (troque pelo endereço que o Render gerar)
VITE_API_URL=http://localhost:8080

# (Opcional) Token do GitHub só de leitura, usado pelo painel "Atividade no GitHub".
# Sem ele funciona, mas com limite de 60 chamadas por hora. SEM o prefixo VITE_:
# fica só no servidor (vite.config.js no dev e Vercel Function api/github.js).
# Como criar: https://github.com/settings/personal-access-tokens (Public repositories, read-only)
GITHUB_TOKEN=
